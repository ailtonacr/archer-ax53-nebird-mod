#!/bin/sh /etc/rc.common
# NetBird client service for TP-Link Archer AX53 V1.
# Follows the wireguard/vpnc init pattern (rc.common + /lib/netbird/netbird.sh).
# Boot integration is deliberately non-blocking: any failure logs and exits,
# never affecting WiFi / WAN / DHCP / NAT / existing VPN.

START=99
STOP=10

. /lib/netbird/netbird.sh

start() {
    local sysmode
    config_load sysmode
    config_get sysmode sysmode mode "router"
    [ "$sysmode" = "router" ] || return 0

    nb_ensure_settings

    local enable
    enable=$(nb_get "$NB_SETTINGS_FILE" enable "0")
    [ "$enable" = "1" ] || {
        echo "netbird: disabled, not starting" >/dev/console 2>&1
        return 0
    }

    # Materialize payload; never block boot on failure.
    if ! nb_materialize; then
        echo "netbird: payload materialization failed (see $NB_LOG)" >/dev/console 2>&1
        return 0
    fi

    # The daemon (service run) auto-connects on start when a valid enrolled
    # config exists; otherwise it sits at NeedsLogin for later enrollment.
    if ! nb_daemon_start; then
        echo "netbird: daemon start failed" >/dev/console 2>&1
        return 0
    fi

    # firewall rules for the WireGuard/ICE handshake + return traffic
    nb_fw_access
}

stop() {
    nb_stop
}

restart() {
    stop
    start
}

reload() {
    restart
}
