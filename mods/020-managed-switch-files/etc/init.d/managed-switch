#!/bin/sh /etc/rc.common
START=98
STOP=10

start() {
	enabled="$(uci -q get managed_switch.main.enabled || echo 0)"
	[ "$enabled" = 1 ] || return 0
	# Never auto-apply a newly flashed VLAN layout. Boot-time application is
	# intentionally blocked until hardware mapping has been validated and a
	# dedicated recovery mechanism is implemented.
	logger -t managed-switch "enabled config present; automatic apply intentionally blocked for safety"
}

stop() {
	return 0
}
