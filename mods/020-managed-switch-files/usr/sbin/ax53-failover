#!/bin/sh
# Gateway failover policy runner. Hardware operations are delegated to an
# explicitly qualified board adapter; never infer qualification from ping.
set -eu
umask 077
ETC=${GF_ETC_ROOT:-/etc}
DATA=${GF_DATA_ROOT:-/tp_data}
RUN=${GF_RUN_ROOT:-/var/run}
LIB=${GF_LIB_ROOT:-/usr/lib/gateway-failover}
CONF="$DATA/gateway-failover/config"
STATE="$RUN/gateway-failover.state"
JOURNAL="$DATA/gateway-failover/journal"
LOCK="$RUN/ax53-network.lock"
SWITCH_PENDING="$DATA/managed-switch/transition.pending"
CLOCK="${GF_CLOCK_FILE:-/proc/uptime}"
ADAPTER="$LIB/board-adapter"
. "$LIB/core.sh"
die() { echo "ax53-failover: $*" >&2; exit 1; }
say() { logger -t ax53-failover "$*" 2>/dev/null || :; echo "$*"; }
atomic() {
    target=$1; shift
    printf '%s\n' "$*" > "$target.tmp.$$" && mv "$target.tmp.$$" "$target"
}
init() {
    mkdir -p "$DATA/gateway-failover" "$RUN"
    [ -f "$CONF" ] || { cp "$ETC/gateway-failover/default.conf" "$CONF.tmp.$" && mv "$CONF.tmp.$" "$CONF"; }
}
read_conf() {
    init
    mode=disabled interval=5 fail_samples=6 recovery_samples=24 auto_return=0
    seen=""
    while IFS='=' read -r key value || [ -n "$key$value" ]; do
        case "$key" in ""|\#*) continue;; esac
        case " $seen " in *" $key "*) die "duplicate configuration key";; esac
        seen="$seen $key"
        case "$key" in
            mode) mode=$value ;;
            interval) interval=$value ;;
            fail_samples) fail_samples=$value ;;
            recovery_samples) recovery_samples=$value ;;
            auto_return) auto_return=$value ;;
            ''|\#*) ;;
            *) die "unknown config key: $key" ;;
        esac
    done < "$CONF"
    for key in mode interval fail_samples recovery_samples auto_return; do
        case " $seen " in *" $key "*) ;; *) die "missing configuration key: $key";; esac
    done
    case "$mode" in disabled|observe|auto) ;; *) die "invalid mode";; esac
    case "$auto_return" in 0|1) ;; *) die "invalid auto_return";; esac
    for num in "$interval" "$fail_samples" "$recovery_samples"; do
        case "$num" in ''|0*|*[!0-9]*) die "invalid positive integer";; esac
        [ "${#num}" -le 4 ] && [ "$num" -le 3600 ] || die "out of range"
    done
    [ "$interval" -ge 2 ] || die "interval too short"
    [ "$fail_samples" -ge 2 ] && [ "$recovery_samples" -ge 2 ] || die "insufficient hysteresis"
}
acquire() {
    # Directory lock releases on ordinary exit via this trap; no stale PID
    # guessing, no parallel transition. The caller must resolve stale lock.
    mkdir -p "$RUN"
    if ! mkdir "$LOCK" 2>/dev/null; then
        say "network controller busy or stale lock" >&2
        exit 75
    fi
    trap 'rmdir "$LOCK" 2>/dev/null || :' EXIT
    trap 'exit 1' HUP INT TERM
}
bounded_adapter() {
    limit=$1; shift
    # Require timeout implementation with a hard-kill grace period. The
    # qualified adapter must not leave asynchronous hardware writers behind.
    command -v timeout >/dev/null 2>&1 || return 1
    timeout -k 2 "$limit" "$ADAPTER" "$@"
}
adapter_ok() {
    [ -x "$ADAPTER" ] && bounded_adapter 10 preflight >/dev/null 2>&1
}
monotonic_now() {
    value=$(awk 'NR == 1 && $1 ~ /^[0-9]+([.][0-9]+)?$/ {sub(/[.].*/, "", $1); print $1; exit}' "$CLOCK")
    case "$value" in ''|*[!0-9]*) die "monotonic clock unavailable";; esac
    [ "${#value}" -le 9 ] || die "clock out of range"
    echo "$value"
}
save_state() {
    atomic "$STATE" "$phase $count $probe $action $last $since $policy"
}
reset_samples() {
    count=0 last=0 since=0 probe=unknown action=none
}
block() {
    phase=ERROR; reset_samples; action=blocked; save_state
    die "$*"
}
load_state() {
    phase=NORMAL count=0 probe=unknown action=none last=0 since=0
    policy="$mode:$interval:$fail_samples:$recovery_samples"
    if [ -f "$STATE" ]; then
        read -r phase count probe action last since previous_policy extra < "$STATE" || die "invalid runtime state"
        [ -z "${extra:-}" ] || die "invalid runtime state fields"
        # Never automatically trust a previous state from an older format.
        [ -n "${last:-}" ] && [ -n "${since:-}" ] && [ -n "${previous_policy:-}" ] || die "old state format requires reconciliation"
        case "$phase" in NORMAL|SUSPECT|FAILOVER|RECOVERY|ERROR) ;; *) die "invalid phase";; esac
        case "$count" in ''|*[!0-9]*) die "invalid count";; esac
        [ "${#count}" -le 4 ] || die "invalid count size"
        for number in "$last" "$since"; do
            case "$number" in ""|*[!0-9]*) die "invalid sample time";; esac
            [ "${#number}" -le 9 ] || die "invalid sample time size"
        done
        if [ "$previous_policy" != "$policy" ]; then reset_samples; fi
    fi
}
probe_primary() {
    if adapter_ok; then
        result=$(bounded_adapter 10 probe-primary 2>/dev/null) || result=unknown
        case "$result" in healthy|down|unknown|upstream-down) echo "$result";; *) echo unknown;; esac
    else
        # ICMP alone is not a qualified health check. No takeover on this.
        if ping -c 1 -W 1 172.24.0.1 >/dev/null 2>&1; then
            echo local-reachable
        else
            echo local-unreachable
        fi
    fi
}
transition() {
    direction=$1
    [ "$mode" = auto ] || die "transition requires auto mode"
    adapter_ok || die "board adapter not qualified"
    # Durable intent precedes any hardware mutation. Interrupted transitions
    # require explicit reconciliation; boot must never blindly retry.
    atomic "$JOURNAL" "pending:$direction"
    sync || die "cannot sync transition intent"
    if bounded_adapter 60 "$direction" && bounded_adapter 15 "verify-$direction"; then
        case "$direction" in takeover) next=FAILOVER;; return) next=NORMAL;; esac
        atomic "$JOURNAL" "stable:$next"
        sync || die "cannot sync transition completion"
        phase=$next; reset_samples; save_state
        say "transition verified: $next"
    else
        phase=ERROR; reset_samples; action=blocked; save_state
        say "transition failed; pending journal retained, manual reconciliation required"
        return 1
    fi
}
reconcile() {
    [ "$phase" != ERROR ] || die "manual reconciliation required"
    if [ -f "$JOURNAL" ]; then
        IFS= read -r journal < "$JOURNAL" || block "unreadable journal"
        case "$journal" in
            pending:*) block "interrupted transition: $journal";;
            stable:FAILOVER) physical=FAILOVER; verify=verify-takeover;;
            stable:NORMAL) physical=NORMAL; verify=verify-return;;
            *) block "invalid journal";;
        esac
    else
        physical=NORMAL; verify=verify-return
    fi
    if [ "$mode" = auto ]; then
        [ ! -f "$SWITCH_PENDING" ] || block "switch transition pending"
        adapter_ok || die "auto refused: board adapter not qualified"
        # Verify layout, NOT reachability of the failed gateway. Adapter
        # verification must be defined to succeed for a fenced/down primary.
        bounded_adapter 15 "$verify" || block "physical layout not reconciled"
    elif [ "$physical" = FAILOVER ]; then
        die "fallback journal requires qualified auto reconciliation"
    fi
    case "$physical:$phase" in
        NORMAL:NORMAL|NORMAL:SUSPECT|FAILOVER:FAILOVER|FAILOVER:RECOVERY) ;;
        *) phase=$physical; reset_samples;;
    esac
}
tick() {
    acquire
    read_conf
    [ "$mode" != disabled ] || return 0
    load_state
    reconcile
    now=$(monotonic_now)
    if [ "$count" -gt 0 ] && [ "$now" -ge "$last" ] && [ $((now-last)) -lt "$interval" ]; then
        return 0
    fi
    probe=$(probe_primary)
    now=$(monotonic_now)
    # Do not count a long scheduling/probe gap or a reset of the boot clock
    # as continuous healthy/unhealthy time.
    if [ "$count" -gt 0 ] && { [ "$now" -lt "$last" ] || [ $((now-last)) -gt $((interval*3)) ]; }; then
        reset_samples
        probe=$(probe_primary)
        now=$(monotonic_now)
    fi
    previous_count=$count
    previous_phase=$phase
    set -- $(fo_step "$phase" "$count" "$probe" "$fail_samples" "$recovery_samples" "$auto_return")
    phase=$1 count=$2 action=$3
    if [ "$count" -eq 0 ]; then since=0
    elif [ "$previous_count" -eq 0 ] || [ "$phase" != "$previous_phase" ]; then since=$now
    fi
    last=$now
    # Both the sample threshold and the full elapsed interval are mandatory.
    # E.g. six 5s intervals require 30s elapsed since first down observation.
    case "$action" in
        takeover) [ $((now-since)) -ge $((interval*fail_samples)) ] || action=none;;
        return) [ $((now-since)) -ge $((interval*recovery_samples)) ] || action=none;;
    esac
    save_state
    if [ "$mode" = auto ]; then
        case "$action" in takeover|return) transition "$action";; esac
    fi
}
case "${1:-}" in
    init) acquire; read_conf ;;
    status)
        acquire; read_conf; load_state
        printf 'mode=%s\nphase=%s\nconsecutive=%s\nprobe=%s\naction=%s\nlast_sample=%s\nfirst_sample=%s\n' "$mode" "$phase" "$count" "$probe" "$action" "$last" "$since"
        if adapter_ok; then echo adapter=qualified; else echo adapter=unqualified; fi
        if [ -f "$JOURNAL" ]; then printf 'journal='; cat "$JOURNAL"; fi ;;
    tick) tick ;;
    manual-return)
        acquire; read_conf
        [ "$mode" = auto ] || die "manual return requires auto mode"
        load_state; reconcile
        [ "$phase" = RECOVERY ] && [ "$count" -ge "$recovery_samples" ] || die "primary recovery not stable"
        [ -f "$JOURNAL" ] && grep -qx "stable:FAILOVER" "$JOURNAL" || die "fallback journal not stable"
        now=$(monotonic_now)
        [ "$now" -ge "$last" ] && [ $((now-last)) -le $((interval*3)) ] && [ $((now-since)) -ge $((interval*recovery_samples)) ] || die "recovery samples stale or insufficient"
        [ "$(probe_primary)" = healthy ] || die "primary no longer healthy"
        transition return ;;
    run)
        while :; do
            read_conf
            [ "$mode" != disabled ] || exit 0
            # Busy lock is transient; all other errors require intervention.
            if "$0" tick; then :; else
                rc=$?
                [ "$rc" -eq 75 ] || { say "watchdog stopped (rc=$rc)" >&2; exit "$rc"; }
            fi
            sleep "$interval"
        done ;;
    *) die "usage: ax53-failover init|status|tick|run|manual-return" ;;
esac
