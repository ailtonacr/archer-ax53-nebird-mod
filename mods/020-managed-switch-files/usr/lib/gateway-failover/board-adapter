#!/bin/sh
set -eu
LIB="${GF_LIB_ROOT:-/usr/lib/gateway-failover}"
# The platform implementation is packaged; it refuses to mutate anything
# without board-specific qualification of readback, ingress, control, and
# native service ownership. No blanket success or marker-only qualification.
PLATFORM="$LIB/qualified-platform"
. "$LIB/transition.sh"
. "$LIB/layout.sh"
platform() {
    "$PLATFORM" "$@"
}
case "${1:-}" in
    plan)
        [ "$#" -eq 3 ] || exit 2
        gf_layout "$2" "$3"; exit $?;;
    diagnostics)
        # Read-only; do not print config files, credentials or private keys.
        for node in vlan port; do
            if [ -r "/proc/driver/rtl8367s/$node" ]; then
                printf '%s\n' "--- rtl8367s/$node ---"
                cat "/proc/driver/rtl8367s/$node"
            fi
        done
        command -v ip >/dev/null && { ip -4 addr show; ip -4 route show; } || :
        [ ! -x "$PLATFORM" ] || "$PLATFORM" diagnostics
        exit 0;;
esac
[ -x "$PLATFORM" ] || { echo "board platform not qualified" >&2; exit 1; }
# Qualification must prove live safety, not only check a file or marker.
platform preflight || exit 1
case "${1:-}" in
    preflight) exit 0;;
    probe-primary) platform probe-primary;;
    takeover) gf_takeover;;
    verify-takeover) gf_verify_takeover;;
    return) gf_return;;
    verify-return) gf_verify_return;;
    *) exit 2;;
esac
