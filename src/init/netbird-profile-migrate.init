#!/bin/sh /etc/rc.common
# One-shot maintenance for native NetBird profiles.
#
# 1. Adopt the historical single NetBird identity into a real TP-Link vpn.server
#    row so an already-installed client appears in the stock VPN Client list.
# 2. Garbage-collect profile-scoped NetBird identities whose authoritative stock
#    vpn.server row no longer exists. Generic DELETE itself remains untouched.
#
# This service never starts/stops NetBird.

START=89
STOP=12

start() {
    local sysmode
    config_load sysmode
    config_get sysmode sysmode mode "router"
    [ "$sysmode" = "router" ] || return 0

    . /lib/netbird/netbird.sh
    . /lib/netbird/netbird-profiles.sh

    if ! nb_legacy_profile_adopt; then
        echo "netbird: legacy profile adoption failed" >/dev/console 2>&1
        return 1
    fi
    if ! nb_profile_gc_orphans; then
        echo "netbird: orphan profile cleanup failed" >/dev/console 2>&1
        return 1
    fi
    return 0
}

stop() {
    return 0
}
