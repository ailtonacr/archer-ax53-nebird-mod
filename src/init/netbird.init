#!/bin/sh /etc/rc.common
# NetBird compatibility/recovery wrapper for TP-Link Archer AX53 V1.
#
# This service is intentionally NOT linked in /etc/rc.d in the native design.
# Normal lifecycle belongs to TP-Link's /etc/init.d/vpnc -> netifd -> proto
# netbird. Manual start/restart delegates to vpnc instead of creating a second
# lifecycle owner. stop may clean an orphan daemon when NetBird is not active.

START=99
STOP=10

. /lib/functions.sh
. /lib/netbird/netbird.sh
. /lib/netbird/netbird-runtime.sh

netbird_native_active() {
    local enabled="off" vpntype="none"
    config_load vpn
    config_get enabled client enabled "off"
    config_get vpntype client vpntype "none"
    [ "$enabled" = "on" ] && [ "$vpntype" = "netbirdvpn" ]
}

start() {
    if ! netbird_native_active; then
        echo "netbird: not the active native VPN Client profile; start skipped" >/dev/console 2>&1
        return 0
    fi
    /etc/init.d/vpnc restart
}

stop() {
    if netbird_native_active; then
        /etc/init.d/vpnc stop
    else
        # Recovery-only orphan cleanup. No payload is downloaded by stop.
        nb_runtime_stop >/dev/null 2>&1 || true
    fi
}

restart() {
    if ! netbird_native_active; then
        echo "netbird: not the active native VPN Client profile; restart skipped" >/dev/console 2>&1
        return 0
    fi
    /etc/init.d/vpnc restart
}

reload() {
    restart
}
