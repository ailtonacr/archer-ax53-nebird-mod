#!/bin/sh
# netbird-ctl -- CLI facade for the NetBird runtime on TP-Link AX53.
#
# Lifecycle implementation lives in /lib/netbird/netbird-runtime.sh so netifd,
# recovery commands and LuCI all share one implementation without circular
# dependencies. Native profile operations must select the stock profile key so
# each stored NetBird row uses its own persistent identity/settings directory.

. /lib/netbird/netbird.sh
. /lib/netbird/netbird-profiles.sh
. /lib/netbird/netbird-runtime.sh

profile_key=""
if [ "${1:-}" = "--profile-key" ]; then
    [ $# -ge 3 ] || { echo "netbird: --profile-key requires a value and command" >&2; exit 2; }
    profile_key="$2"
    nb_profile_select "$profile_key" || exit 2
    shift 2
elif [ "${1:-}" != "payload-version" ] && [ "${1:-}" != "payload-status" ] && [ "${1:-}" != "payload-verify" ]; then
    # Compatibility/manual diagnostics may omit the key. Prefer the currently
    # active native profile when one can be resolved; otherwise retain the
    # historical root context without ever treating it as a new native profile.
    nb_profile_select_active >/dev/null 2>&1 || true
fi

case "${1:-}" in
daemon-ping)
    nb_daemon_ping
    exit $?
    ;;

up)
    shift
    keyfile=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --setup-key-file)
                [ $# -ge 2 ] || { echo "netbird: --setup-key-file requires a path" >&2; exit 2; }
                keyfile="$2"
                shift 2
                ;;
            --setup-key-file=*)
                keyfile="${1#--setup-key-file=}"
                shift
                ;;
            *)
                echo "netbird: unsupported netbird-ctl up argument: $1" >&2
                exit 2
                ;;
        esac
    done
    nb_runtime_connect "$keyfile"
    exit $?
    ;;

down)
    nb_runtime_disconnect
    exit $?
    ;;

stop)
    nb_runtime_stop
    exit $?
    ;;

restart)
    nb_runtime_restart
    exit $?
    ;;

clean)
    nb_clean
    exit $?
    ;;

status)
    nb_status_json
    exit 0
    ;;

log)
    n="${2:-100}"
    case "$n" in ''|*[!0-9]*) n=100 ;; esac
    [ "$n" -gt 500 ] && n=500
    tail -n "$n" "$NB_LOG" 2>/dev/null
    ;;

settings)
    nb_ensure_settings
    sed -n 's/^\(description\|enable\|enrolled\|management_url\|hostname\|disable_dns\|disable_firewall\|disable_client_routes\|disable_server_routes\|disable_ipv6\|network_monitor\|advertise_lan\|advertise_cidr\|wireguard_port\)=/\1=/p' \
        "$NB_SETTINGS_FILE" 2>/dev/null
    ;;

migrate-profile)
    nb_profile_use_legacy
    nb_legacy_profile_adopt
    exit $?
    ;;

payload-version)
    echo "$NB_VERSION"
    ;;

payload-status)
    nb_payload_status
    rc=$?
    nb_state_name "$rc"
    exit "$rc"
    ;;

payload-verify)
    nb_payload_verify
    rc=$?
    nb_state_name "$rc"
    exit "$rc"
    ;;

*)
    echo "usage: $0 [--profile-key KEY] {up [--setup-key-file PATH]|down|stop|restart|clean|status|log|settings|daemon-ping} | {migrate-profile|payload-version|payload-status|payload-verify}" >&2
    exit 1
    ;;
esac
