#!/bin/sh
# Polling recovery supervisor for native NetBird on TP-Link Archer AX53 V1.
#
# This process is intentionally NOT a NetBird lifecycle owner. It never starts
# the NetBird daemon or calls nb_runtime_connect directly. It only observes the
# persisted TP-Link VPN Client intent and re-triggers the stock netifd lifecycle
# when the selected NetBird profile should be active but is not connected.

NB_RECOVERY_LOCK="${NB_RECOVERY_LOCK:-/tmp/netbird-recovery-attempt.lock}"
NB_RECOVERY_INITIAL_DELAY="${NB_RECOVERY_INITIAL_DELAY:-5}"
NB_RECOVERY_MAX_DELAY="${NB_RECOVERY_MAX_DELAY:-300}"
NB_RECOVERY_CONNECTED_POLL="${NB_RECOVERY_CONNECTED_POLL:-300}"
NB_RECOVERY_INACTIVE_POLL="${NB_RECOVERY_INACTIVE_POLL:-60}"
NB_RECOVERY_PENDING_POLL="${NB_RECOVERY_PENDING_POLL:-5}"
NB_RECOVERY_IDENTITY_POLL="${NB_RECOVERY_IDENTITY_POLL:-300}"
NB_RECOVERY_CONNECT_GRACE="${NB_RECOVERY_CONNECT_GRACE:-35}"

NB_RECOVERY_FAILURES=0
NB_RECOVERY_DELAY="$NB_RECOVERY_INITIAL_DELAY"
NB_RECOVERY_STEP_STATE="init"

nb_recovery_log() {
    printf '%s\n' "netbird-recovery: $*" >/dev/console 2>/dev/null || true
}
nb_recovery_sleep() { sleep "$1"; }
nb_recovery_delay_for_failure() {
    case "${1:-1}" in
        1) printf '%s\n' 5 ;;
        2) printf '%s\n' 10 ;;
        3) printf '%s\n' 20 ;;
        4) printf '%s\n' 40 ;;
        5) printf '%s\n' 80 ;;
        6) printf '%s\n' 160 ;;
        *) printf '%s\n' "$NB_RECOVERY_MAX_DELAY" ;;
    esac
}

nb_recovery_native_active() {
    local enabled vpntype
    enabled="$(uci -q get vpn.client.enabled 2>/dev/null || true)"
    vpntype="$(uci -q get vpn.client.vpntype 2>/dev/null || true)"
    [ "$enabled" = "on" ] || return 1
    case "$vpntype" in netbirdvpn|netbird) return 0 ;; *) return 1 ;; esac
}

nb_recovery_identity_ready() {
    local enrolled
    enrolled="$(nb_get "$NB_SETTINGS_FILE" enrolled "0" 2>/dev/null || true)"
    [ "$enrolled" = "1" ] && return 0
    [ -s "$NB_CONFIG_FILE" ]
}

nb_recovery_netifd_pending() {
    local status compact
    status="$(ubus call network.interface.vpn status 2>/dev/null)" || return 1
    compact="$(printf '%s' "$status" | tr -d '\r\n\t ')"
    printf '%s' "$compact" | grep -q '"pending":true'
}
nb_recovery_interface_exists() { ubus call network.interface.vpn status >/dev/null 2>&1; }

nb_recovery_trigger() (
    if ! mkdir "$NB_RECOVERY_LOCK" 2>/dev/null; then return 2; fi
    trap 'rc=$?; rmdir "$NB_RECOVERY_LOCK" 2>/dev/null || true; exit "$rc"' EXIT
    trap 'rmdir "$NB_RECOVERY_LOCK" 2>/dev/null || true; exit 1' HUP INT TERM
    nb_recovery_native_active || return 3
    nb_profile_select_active >/dev/null 2>&1 || return 4

    if nb_recovery_interface_exists; then
        ubus call network.interface.vpn disconnect >/dev/null 2>&1 || true
        ubus call network.interface.vpn connect >/dev/null 2>&1
    else
        /etc/init.d/vpnc restart >/dev/null 2>&1
    fi
)

nb_recovery_wait_connected() {
    local tries="${1:-$NB_RECOVERY_CONNECT_GRACE}"
    while [ "$tries" -gt 0 ]; do
        nb_recovery_native_active || return 2
        nb_profile_select_active >/dev/null 2>&1 || return 3
        nb_runtime_is_connected && return 0
        tries=$((tries - 1))
        nb_recovery_sleep 1
    done
    return 1
}

nb_recovery_record_failure() {
    NB_RECOVERY_FAILURES=$((NB_RECOVERY_FAILURES + 1))
    NB_RECOVERY_DELAY="$(nb_recovery_delay_for_failure "$NB_RECOVERY_FAILURES")"
    [ "$NB_RECOVERY_DELAY" -le "$NB_RECOVERY_MAX_DELAY" ] || NB_RECOVERY_DELAY="$NB_RECOVERY_MAX_DELAY"
}

nb_recovery_step() {
    local trigger_rc wait_rc

    if ! nb_recovery_native_active; then
        NB_RECOVERY_FAILURES=0
        NB_RECOVERY_DELAY="$NB_RECOVERY_INACTIVE_POLL"
        NB_RECOVERY_STEP_STATE="inactive"
        return 0
    fi

    if ! nb_profile_select_active >/dev/null 2>&1; then
        NB_RECOVERY_FAILURES=0
        NB_RECOVERY_DELAY="$NB_RECOVERY_IDENTITY_POLL"
        NB_RECOVERY_STEP_STATE="profile-key-missing"
        return 0
    fi

    if nb_runtime_is_connected; then
        NB_RECOVERY_FAILURES=0
        NB_RECOVERY_DELAY="$NB_RECOVERY_CONNECTED_POLL"
        NB_RECOVERY_STEP_STATE="connected"
        return 0
    fi

    if ! nb_recovery_identity_ready; then
        NB_RECOVERY_FAILURES=0
        NB_RECOVERY_DELAY="$NB_RECOVERY_IDENTITY_POLL"
        NB_RECOVERY_STEP_STATE="identity-not-ready"
        return 0
    fi

    if nb_recovery_netifd_pending; then
        NB_RECOVERY_DELAY="$NB_RECOVERY_PENDING_POLL"
        NB_RECOVERY_STEP_STATE="netifd-pending"
        return 0
    fi

    trigger_rc=0
    nb_recovery_trigger || trigger_rc=$?
    case "$trigger_rc" in
        0) ;;
        2)
            NB_RECOVERY_DELAY="$NB_RECOVERY_PENDING_POLL"
            NB_RECOVERY_STEP_STATE="attempt-locked"
            return 0 ;;
        3)
            NB_RECOVERY_FAILURES=0
            NB_RECOVERY_DELAY="$NB_RECOVERY_INACTIVE_POLL"
            NB_RECOVERY_STEP_STATE="inactive"
            return 0 ;;
        4)
            NB_RECOVERY_FAILURES=0
            NB_RECOVERY_DELAY="$NB_RECOVERY_IDENTITY_POLL"
            NB_RECOVERY_STEP_STATE="profile-key-missing"
            return 0 ;;
        *)
            nb_recovery_record_failure
            NB_RECOVERY_STEP_STATE="trigger-failed"
            nb_recovery_log "native reconnect trigger failed; retry in ${NB_RECOVERY_DELAY}s"
            return 0 ;;
    esac

    wait_rc=0
    nb_recovery_wait_connected "$NB_RECOVERY_CONNECT_GRACE" || wait_rc=$?
    case "$wait_rc" in
        0)
            NB_RECOVERY_FAILURES=0
            NB_RECOVERY_DELAY="$NB_RECOVERY_CONNECTED_POLL"
            NB_RECOVERY_STEP_STATE="connected"
            nb_recovery_log "NetBird recovered through native vpnc/netifd lifecycle" ;;
        2)
            NB_RECOVERY_FAILURES=0
            NB_RECOVERY_DELAY="$NB_RECOVERY_INACTIVE_POLL"
            NB_RECOVERY_STEP_STATE="inactive" ;;
        3)
            NB_RECOVERY_FAILURES=0
            NB_RECOVERY_DELAY="$NB_RECOVERY_IDENTITY_POLL"
            NB_RECOVERY_STEP_STATE="profile-key-missing" ;;
        *)
            nb_recovery_record_failure
            NB_RECOVERY_STEP_STATE="connect-failed"
            nb_recovery_log "NetBird still disconnected; retry in ${NB_RECOVERY_DELAY}s" ;;
    esac
    return 0
}

nb_recovery_run() {
    while :; do
        nb_recovery_step
        nb_recovery_sleep "$NB_RECOVERY_DELAY"
    done
}

if [ "${NB_RECOVERY_INCLUDE_ONLY:-0}" != "1" ]; then
    . /lib/netbird/netbird.sh
    . /lib/netbird/netbird-profiles.sh
    . /lib/netbird/netbird-runtime.sh

    case "${1:-run}" in
        run) nb_recovery_run ;;
        once)
            nb_recovery_step
            printf 'state=%s failures=%s next_delay=%s\n' "$NB_RECOVERY_STEP_STATE" "$NB_RECOVERY_FAILURES" "$NB_RECOVERY_DELAY" ;;
        *) echo "Usage: $0 [run|once]" >&2; exit 2 ;;
    esac
fi
